{"type":"tool_use","timestamp":1793383451215,"sessionID":"ses_e72053da9ffeY5Vp446Zu901pu","part":{"type":"tool","tool":"read","callID":"call_01a18dfbc709754fa8d4d75a2eb4f6c6","state":{"status":"completed","input":{"filePath":"/kaggle/tmp/AI-Scientist-v3-main/results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/sim.py","offset":50,"limit":95},"output":"<path>/kaggle/tmp/AI-Scientist-v3-main/results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/sim.py</path>\n<type>file</type>\n<content>\n50:     \"\"\"ECI initial state [x, y, z, vx, vy, vz] (m, m/s) from MEAN orbital elements (a = R_EARTH + alt_m).\n51:     Use the same elements in fast_positions() for screening; the two agree to about 5-30 km over 48 h.\n52:     The verifier checks the altitude band on the INSTANTANEOUS perigee/apogee of this state, which can differ from the mean\n53:     altitude by several km: check sim.orbit_altitudes(state) against the band before using a state.\"\"\"\n54:     mean = np.array([R_EARTH + alt_m, ecc, inc_deg, raan_deg, argp_deg, mean_anomaly_deg])\n55:     osc = np.asarray(brahe.state_koe_mean_to_osc(mean, brahe.MeanElementMethod.BROUWER_LYDDANE, brahe.AngleFormat.DEGREES), float)\n56:     return np.asarray(brahe.state_koe_to_eci(osc, brahe.AngleFormat.DEGREES), float)\n57: \n58: def orbit_altitudes(state):\n59:     \"\"\"(perigee_alt_m, apogee_alt_m) of an ECI state, as the verifier computes them.\"\"\"\n60:     r, v = np.asarray(state[:3], float), np.asarray(state[3:], float); rn, vn = np.linalg.norm(r), np.linalg.norm(v)\n61:     a = -GM_EARTH / (2 * (0.5 * vn * vn - GM_EARTH / rn)); ev = ((vn * vn - GM_EARTH / rn) * r - np.dot(r, v) * v) / GM_EARTH; e = np.linalg.norm(ev)\n62:     return a * (1 - e) - R_EARTH, a * (1 + e) - R_EARTH\n63: \n64: def fast_positions(world, elements):\n65:     \"\"\"Approximate ECEF tracks (n, T, 3) for a list of mean-element tuples (alt_m, inc_deg, raan_deg, mean_anomaly_deg[, ecc, argp_deg]),\n66:     using secular J2 drift. About 1 ms per satellite. Error vs exact propagation: about 5-30 km over 48 h for near-circular orbits (footprint radius is several hundred km).\"\"\"\n67:     ts = world['times']; out = []\n68:     for el in elements:\n69:         alt, inc, raan, ma = el[:4]; ecc = el[4] if len(el) > 4 else 0.0; argp = el[5] if len(el) > 5 else 0.0\n70:         a = R_EARTH + alt; n = math.sqrt(GM_EARTH / a ** 3); p = a * (1 - ecc ** 2); f = 1.5 * J2 * (R_EARTH / p) ** 2; ci = math.cos(math.radians(inc))\n71:         O = math.radians(raan) - f * n * ci * ts\n72:         w = math.radians(argp) + 0.5 * f * n * (5 * ci ** 2 - 1) * ts\n73:         M = math.radians(ma) + n * (1 + 0.5 * f * math.sqrt(1 - ecc ** 2) * (3 * ci ** 2 - 1)) * ts\n74:         E = M.copy()\n75:         for _ in range(8): E = E - (E - ecc * np.sin(E) - M) / (1 - ecc * np.cos(E))\n76:         nu = 2 * np.arctan2(math.sqrt(1 + ecc) * np.sin(E / 2), math.sqrt(1 - ecc) * np.cos(E / 2)); rr = a * (1 - ecc * np.cos(E)); u = w + nu; i = math.radians(inc)\n77:         r = np.stack([np.cos(O) * np.cos(u) - np.sin(O) * np.sin(u) * math.cos(i), np.sin(O) * np.cos(u) + np.cos(O) * np.sin(u) * math.cos(i), np.sin(u) * math.sin(i)], 1) * rr[:, None]\n78:         out.append(np.einsum('tij,tj->ti', world['rot'], r))\n79:     return np.array(out)\n80: \n81: def exact_propagate(world, states):\n82:     \"\"\"Exact (verifier) propagation. Returns (eci (n,T,3), ecef (n,T,3), propagators). About 1 s per satellite on a fast CPU.\n83:     ECEF = world['rot'] applied to ECI (identical to brahe's own conversion to < 1 mm).\"\"\"\n84:     e0, e1 = epoch(world), epoch(world, world['horizon_s'])\n85:     fc = brahe.ForceModelConfig(gravity=brahe.GravityConfiguration.spherical_harmonic(2, 0)); eps = [e0 + float(t) for t in world['times']]\n86:     props, eci, ecef = [], [], []\n87:     for s in states:\n88:         p = brahe.NumericalOrbitPropagator.from_eci(e0, np.asarray(s, float), force_config=fc); p.propagate_to(e1); props.append(p)\n89:         eci.append(np.asarray(p.states_eci(eps), float)[:, :3])\n90:     eci = np.array(eci) if eci else np.zeros((0, len(world['times']), 3))\n91:     return eci, np.einsum('tij,ntj->nti', world['rot'], eci), props\n92: \n93: # ---------------- geometry ----------------\n94: def visible(world, ecef_track, margin_deg=1e-3):\n95:     \"\"\"Boolean (n_targets, T): target j observable from this satellite track at each grid time (all geometry limits).\"\"\"\n96:     sen = world['model']['sensor']; out = []\n97:     for t in world['targets']:\n98:         tp = t['ecef']; los = ecef_track - tp; rng = np.linalg.norm(los, axis=1)\n99:         lat, lon = math.radians(t['latitude_deg']), math.radians(t['longitude_deg'])\n100:         up = np.array([math.cos(lat) * math.cos(lon), math.cos(lat) * math.sin(lon), math.sin(lat)])\n101:         el = np.degrees(np.arcsin(np.clip(los @ up / rng, -1, 1)))\n102:         offn = np.degrees(np.arccos(np.clip(np.sum(-ecef_track * (tp - ecef_track), 1) / (np.linalg.norm(ecef_track, axis=1) * rng), -1, 1)))\n103:         out.append((el >= t['min_elevation_deg'] + margin_deg) & (rng <= t['max_slant_range_m'] - 1.0) & (rng <= sen['max_range_m'] - 1.0) & (offn <= sen['max_off_nadir_angle_deg'] - margin_deg))\n104:     return np.array(out)\n105: \n106: def slew_time(angle_deg, world):\n107:     att = world['model']['attitude_model']; a = max(0.0, angle_deg)\n108:     if a <= 1e-9: return 0.0\n109:     v, acc = att['max_slew_velocity_deg_per_sec'], att['max_slew_acceleration_deg_per_sec2']; tri = v * v / acc\n110:     return 2 * math.sqrt(a / acc) if a <= tri else 2 * v / acc + (a - tri) / v\n111: \n112: def line_of_sight_eci(world, propagator, target_index, t_s):\n113:     \"\"\"Inertial vector satellite -> target at time t_s (exact propagator), for slew angles.\"\"\"\n114:     ep = epoch(world, t_s); sat = np.asarray(propagator.state_eci(ep), float)[:3]\n115:     return np.asarray(brahe.position_ecef_to_eci(ep, world['targets'][target_index]['ecef']), float) - sat\n116: \n117: def angle_deg(u, v):\n118:     return math.degrees(math.acos(max(-1.0, min(1.0, float(np.dot(u, v) / (np.linalg.norm(u) * np.linalg.norm(v)))))))\n119: \n120: # ---------------- score ----------------\n121: def max_gaps_hours(world, midpoints_by_target):\n122:     \"\"\"midpoints_by_target: dict target_index -> observation midpoints (s). Returns per-target max gap (h), boundaries included.\"\"\"\n123:     H = world['horizon_s']; g = []\n124:     for j in range(len(world['targets'])):\n125:         pts = [0.0] + sorted(set(midpoints_by_target.get(j, []))) + [H]; g.append(max(b - a for a, b in zip(pts, pts[1:])) / 3600.0)\n126:     return np.array(g)\n127: \n128: def mission_score(world, n_satellites, max_gaps_h, valid=True):\n129:     \"\"\"Task score for one mission (same rule as evaluate.py). 0 if invalid.\n130:     If any target misses its revisit period: 70 * mean_j phi(g_j), phi = 1 if g <= req else ((H-g)/(H-req))^2.\n131:     If every target meets it: 70 + 30 * (cap - n) / (cap - 1).\"\"\"\n132:     if not valid or n_satellites < 1: return 0.0\n133:     H = world['horizon_s'] / 3600.0; req = np.array([t['expected_revisit_period_hours'] for t in world['targets']]); g = np.asarray(max_gaps_h, float)\n134:     if np.all(g <= req + 1e-9):\n135:         return 70.0 + 30.0 * (world['cap'] - n_satellites) / max(world['cap'] - 1, 1)\n136:     phi = np.where(g <= req, 1.0, np.clip((H - g) / (H - req), 0, 1) ** 2); return 70.0 * float(phi.mean())\n137: \n138: def to_solution_json(world, states, actions):\n139:     iso = lambda s: (world['start'] + timedelta(seconds=float(s))).strftime('%Y-%m-%dT%H:%M:%SZ') if float(s).is_integer() else \\\n140:         (world['start'] + timedelta(seconds=float(s))).isoformat().replace('+00:00', 'Z')\n141:     sats = [dict(satellite_id=f'sat_{i+1:03d}', x_m=float(s[0]), y_m=float(s[1]), z_m=float(s[2]), vx_m_s=float(s[3]), vy_m_s=float(s[4]), vz_m_s=float(s[5])) for i, s in enumerate(states)]\n142:     acts = [dict(action_type='observation', satellite_id=f'sat_{int(i)+1:03d}', target_id=world['targets'][int(j)]['id'], start=iso(a), end=iso(b)) for (i, j, a, b) in sorted(actions, key=lambda q: (q[0], q[2]))]\n143:     return dict(satellites=sats, actions=acts)\n144: \n\n(Showing lines 50-144 of 153. Use offset=145 to continue.)\n</content>","metadata":{"preview":"    \"\"\"ECI initial state [x, y, z, vx, vy, vz] (m, m/s) from MEAN orbital elements (a = R_EARTH + alt_m).\n    Use the same elements in fast_positions() for screening; the two agree to about 5-30 km over 48 h.\n    The verifier checks the altitude band on the INSTANTANEOUS perigee/apogee of this state, which can differ from the mean\n    altitude by several km: check sim.orbit_altitudes(state) against the band before using a state.\"\"\"\n    mean = np.array([R_EARTH + alt_m, ecc, inc_deg, raan_deg, argp_deg, mean_anomaly_deg])\n    osc = np.asarray(brahe.state_koe_mean_to_osc(mean, brahe.MeanElementMethod.BROUWER_LYDDANE, brahe.AngleFormat.DEGREES), float)\n    return np.asarray(brahe.state_koe_to_eci(osc, brahe.AngleFormat.DEGREES), float)\n\ndef orbit_altitudes(state):\n    \"\"\"(perigee_alt_m, apogee_alt_m) of an ECI state, as the verifier computes them.\"\"\"\n    r, v = np.asarray(state[:3], float), np.asarray(state[3:], float); rn, vn = np.linalg.norm(r), np.linalg.norm(v)\n    a = -GM_EARTH / (2 * (0.5 * vn * vn - GM_EARTH / rn)); ev = ((vn * vn - GM_EARTH / rn) * r - np.dot(r, v) * v) / GM_EARTH; e = np.linalg.norm(ev)\n    return a * (1 - e) - R_EARTH, a * (1 + e) - R_EARTH\n\ndef fast_positions(world, elements):\n    \"\"\"Approximate ECEF tracks (n, T, 3) for a list of mean-element tuples (alt_m, inc_deg, raan_deg, mean_anomaly_deg[, ecc, argp_deg]),\n    using secular J2 drift. About 1 ms per satellite. Error vs exact propagation: about 5-30 km over 48 h for near-circular orbits (footprint radius is several hundred km).\"\"\"\n    ts = world['times']; out = []\n    for el in elements:\n        alt, inc, raan, ma = el[:4]; ecc = el[4] if len(el) > 4 else 0.0; argp = el[5] if len(el) > 5 else 0.0","truncated":true,"loaded":[],"display":{"type":"file","path":"/kaggle/tmp/AI-Scientist-v3-main/results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/sim.py","text":"    \"\"\"ECI initial state [x, y, z, vx, vy, vz] (m, m/s) from MEAN orbital elements (a = R_EARTH + alt_m).\n    Use the same elements in fast_positions() for screening; the two agree to about 5-30 km over 48 h.\n    The verifier checks the altitude band on the INSTANTANEOUS perigee/apogee of this state, which can differ from the mean\n    altitude by several km: check sim.orbit_altitudes(state) against the band before using a state.\"\"\"\n    mean = np.array([R_EARTH + alt_m, ecc, inc_deg, raan_deg, argp_deg, mean_anomaly_deg])\n    osc = np.asarray(brahe.state_koe_mean_to_osc(mean, brahe.MeanElementMethod.BROUWER_LYDDANE, brahe.AngleFormat.DEGREES), float)\n    return np.asarray(brahe.state_koe_to_eci(osc, brahe.AngleFormat.DEGREES), float)\n\ndef orbit_altitudes(state):\n    \"\"\"(perigee_alt_m, apogee_alt_m) of an ECI state, as the verifier computes them.\"\"\"\n    r, v = np.asarray(state[:3], float), np.asarray(state[3:], float); rn, vn = np.linalg.norm(r), np.linalg.norm(v)\n    a = -GM_EARTH / (2 * (0.5 * vn * vn - GM_EARTH / rn)); ev = ((vn * vn - GM_EARTH / rn) * r - np.dot(r, v) * v) / GM_EARTH; e = np.linalg.norm(ev)\n    return a * (1 - e) - R_EARTH, a * (1 + e) - R_EARTH\n\ndef fast_positions(world, elements):\n    \"\"\"Approximate ECEF tracks (n, T, 3) for a list of mean-element tuples (alt_m, inc_deg, raan_deg, mean_anomaly_deg[, ecc, argp_deg]),\n    using secular J2 drift. About 1 ms per satellite. Error vs exact propagation: about 5-30 km over 48 h for near-circular orbits (footprint radius is several hundred km).\"\"\"\n    ts = world['times']; out = []\n    for el in elements:\n        alt, inc, raan, ma = el[:4]; ecc = el[4] if len(el) > 4 else 0.0; argp = el[5] if len(el) > 5 else 0.0\n        a = R_EARTH + alt; n = math.sqrt(GM_EARTH / a ** 3); p = a * (1 - ecc ** 2); f = 1.5 * J2 * (R_EARTH / p) ** 2; ci = math.cos(math.radians(inc))\n        O = math.radians(raan) - f * n * ci * ts\n        w = math.radians(argp) + 0.5 * f * n * (5 * ci ** 2 - 1) * ts\n        M = math.radians(ma) + n * (1 + 0.5 * f * math.sqrt(1 - ecc ** 2) * (3 * ci ** 2 - 1)) * ts\n        E = M.copy()\n        for _ in range(8): E = E - (E - ecc * np.sin(E) - M) / (1 - ecc * np.cos(E))\n        nu = 2 * np.arctan2(math.sqrt(1 + ecc) * np.sin(E / 2), math.sqrt(1 - ecc) * np.cos(E / 2)); rr = a * (1 - ecc * np.cos(E)); u = w + nu; i = math.radians(inc)\n        r = np.stack([np.cos(O) * np.cos(u) - np.sin(O) * np.sin(u) * math.cos(i), np.sin(O) * np.cos(u) + np.cos(O) * np.sin(u) * math.cos(i), np.sin(u) * math.sin(i)], 1) * rr[:, None]\n        out.append(np.einsum('tij,tj->ti', world['rot'], r))\n    return np.array(out)\n\ndef exact_propagate(world, states):\n    \"\"\"Exact (verifier) propagation. Returns (eci (n,T,3), ecef (n,T,3), propagators). About 1 s per satellite on a fast CPU.\n    ECEF = world['rot'] applied to ECI (identical to brahe's own conversion to < 1 mm).\"\"\"\n    e0, e1 = epoch(world), epoch(world, world['horizon_s'])\n    fc = brahe.ForceModelConfig(gravity=brahe.GravityConfiguration.spherical_harmonic(2, 0)); eps = [e0 + float(t) for t in world['times']]\n    props, eci, ecef = [], [], []\n    for s in states:\n        p = brahe.NumericalOrbitPropagator.from_eci(e0, np.asarray(s, float), force_config=fc); p.propagate_to(e1); props.append(p)\n        eci.append(np.asarray(p.states_eci(eps), float)[:, :3])\n    eci = np.array(eci) if eci else np.zeros((0, len(world['times']), 3))\n    return eci, np.einsum('tij,ntj->nti', world['rot'], eci), props\n\n# ---------------- geometry ----------------\ndef visible(world, ecef_track, margin_deg=1e-3):\n    \"\"\"Boolean (n_targets, T): target j observable from this satellite track at each grid time (all geometry limits).\"\"\"\n    sen = world['model']['sensor']; out = []\n    for t in world['targets']:\n        tp = t['ecef']; los = ecef_track - tp; rng = np.linalg.norm(los, axis=1)\n        lat, lon = math.radians(t['latitude_deg']), math.radians(t['longitude_deg'])\n        up = np.array([math.cos(lat) * math.cos(lon), math.cos(lat) * math.sin(lon), math.sin(lat)])\n        el = np.degrees(np.arcsin(np.clip(los @ up / rng, -1, 1)))\n        offn = np.degrees(np.arccos(np.clip(np.sum(-ecef_track * (tp - ecef_track), 1) / (np.linalg.norm(ecef_track, axis=1) * rng), -1, 1)))\n        out.append((el >= t['min_elevation_deg'] + margin_deg) & (rng <= t['max_slant_range_m'] - 1.0) & (rng <= sen['max_range_m'] - 1.0) & (offn <= sen['max_off_nadir_angle_deg'] - margin_deg))\n    return np.array(out)\n\ndef slew_time(angle_deg, world):\n    att = world['model']['attitude_model']; a = max(0.0, angle_deg)\n    if a <= 1e-9: return 0.0\n    v, acc = att['max_slew_velocity_deg_per_sec'], att['max_slew_acceleration_deg_per_sec2']; tri = v * v / acc\n    return 2 * math.sqrt(a / acc) if a <= tri else 2 * v / acc + (a - tri) / v\n\ndef line_of_sight_eci(world, propagator, target_index, t_s):\n    \"\"\"Inertial vector satellite -> target at time t_s (exact propagator), for slew angles.\"\"\"\n    ep = epoch(world, t_s); sat = np.asarray(propagator.state_eci(ep), float)[:3]\n    return np.asarray(brahe.position_ecef_to_eci(ep, world['targets'][target_index]['ecef']), float) - sat\n\ndef angle_deg(u, v):\n    return math.degrees(math.acos(max(-1.0, min(1.0, float(np.dot(u, v) / (np.linalg.norm(u) * np.linalg.norm(v)))))))\n\n# ---------------- score ----------------\ndef max_gaps_hours(world, midpoints_by_target):\n    \"\"\"midpoints_by_target: dict target_index -> observation midpoints (s). Returns per-target max gap (h), boundaries included.\"\"\"\n    H = world['horizon_s']; g = []\n    for j in range(len(world['targets'])):\n        pts = [0.0] + sorted(set(midpoints_by_target.get(j, []))) + [H]; g.append(max(b - a for a, b in zip(pts, pts[1:])) / 3600.0)\n    return np.array(g)\n\ndef mission_score(world, n_satellites, max_gaps_h, valid=True):\n    \"\"\"Task score for one mission (same rule as evaluate.py). 0 if invalid.\n    If any target misses its revisit period: 70 * mean_j phi(g_j), phi = 1 if g <= req else ((H-g)/(H-req))^2.\n    If every target meets it: 70 + 30 * (cap - n) / (cap - 1).\"\"\"\n    if not valid or n_satellites < 1: return 0.0\n    H = world['horizon_s'] / 3600.0; req = np.array([t['expected_revisit_period_hours'] for t in world['targets']]); g = np.asarray(max_gaps_h, float)\n    if np.all(g <= req + 1e-9):\n        return 70.0 + 30.0 * (world['cap'] - n_satellites) / max(world['cap'] - 1, 1)\n    phi = np.where(g <= req, 1.0, np.clip((H - g) / (H - req), 0, 1) ** 2); return 70.0 * float(phi.mean())\n\ndef to_solution_json(world, states, actions):\n    iso = lambda s: (world['start'] + timedelta(seconds=float(s))).strftime('%Y-%m-%dT%H:%M:%SZ') if float(s).is_integer() else \\\n        (world['start'] + timedelta(seconds=float(s))).isoformat().replace('+00:00', 'Z')\n    sats = [dict(satellite_id=f'sat_{i+1:03d}', x_m=float(s[0]), y_m=float(s[1]), z_m=float(s[2]), vx_m_s=float(s[3]), vy_m_s=float(s[4]), vz_m_s=float(s[5])) for i, s in enumerate(states)]\n    acts = [dict(action_type='observation', satellite_id=f'sat_{int(i)+1:03d}', target_id=world['targets'][int(j)]['id'], start=iso(a), end=iso(b)) for (i, j, a, b) in sorted(actions, key=lambda q: (q[0], q[2]))]\n    return dict(satellites=sats, actions=acts)\n","lineStart":50,"lineEnd":144,"totalLines":153,"truncated":true}},"title":"results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/sim.py","time":{"start":1793383450997,"end":1793383451205}},"metadata":{"openai":{"itemId":"fc_01a18dfbc709754fa8d4d75a2eb4f6c6"}},"id":"prt_18dfbc8f1001eQelKp4rPqxbL3","sessionID":"ses_e72053da9ffeY5Vp446Zu901pu","messageID":"msg_18dfbc343001ynqaW1ZKa0fO3K"}}
