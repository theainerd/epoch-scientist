{"type":"tool_use","timestamp":1793383420922,"sessionID":"ses_e72053da9ffeY5Vp446Zu901pu","part":{"type":"tool","tool":"read","callID":"call_01a18dfb4fad769ba899d6b2e135e5de","state":{"status":"completed","input":{"filePath":"/kaggle/tmp/AI-Scientist-v3-main/results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/program_0/src/program.py"},"output":"<path>/kaggle/tmp/AI-Scientist-v3-main/results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/program_0/src/program.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Window-flexible slew-aware constellation (cycle-9).\n2: \n3: Order of work in solve():\n4:  1. Build and internally verify a cap-sized Walker seed; store as best-so-far\n5:     before any improvement (seed-first, never-empty return).\n6:  2. One fast-propagation pass caches, per visibility window, a small\n7:     deduplicated set of interior candidate instants (buffered start,\n8:     quartiles, buffered end); no exact propagation anywhere in solve().\n9:  3. Gap-critical window-flexible scheduler: fill the largest\n10:     requirement-normalised edge-inclusive gap, choosing the instant that\n11:     minimises slew+settling cost against predecessor/successor while\n12:     maximising post-insertion slack. Bounded slew-safe time-shift repair\n13:     shifts conflicting neighbours only within their own windows, with\n14:     non-overlap/slew/settling/battery re-checked before any insertion,\n15:     plus an independent final slew/settling/battery audit.\n16:  4. Verified pruning: singles first, then pairs only after singles stall;\n17:     a smaller fleet is accepted only after a full cached requirement-exact\n18:     (<=0.02h epsilon) edge-inclusive re-schedule plus slew/battery audit.\n19: Hard internal deadline at 50% of time_limit_s is checked inside every\n20: costly loop; on expiry the best verified non-empty plan is returned.\n21: All parameters derive from world cap/requirements/duration.\n22: \"\"\"\n23: import math\n24: import time\n25: import bisect\n26: \n27: import numpy as np\n28: import sim\n29: \n30: \n31: # ---------------------------------------------------------------- helpers\n32: def _clip(v, lo, hi):\n33:     return float(min(max(v, lo), hi))\n34: \n35: \n36: def _walker_elements(n, alt_m, inc_deg):\n37:     \"\"\"Uneven-plane Walker-like elements: list of (alt, inc, raan, mean_anom).\"\"\"\n38:     n = int(max(1, n))\n39:     planes = max(1, int(round(math.sqrt(n))))\n40:     base, rem = divmod(n, planes)\n41:     els = []\n42:     for p in range(planes):\n43:         cnt = base + (1 if p < rem else 0)\n44:         if cnt == 0:\n45:             continue\n46:         raan = 360.0 * p / planes\n47:         for s in range(cnt):\n48:             ma = 360.0 * s / cnt + 360.0 * p / max(n, 1)\n49:             els.append((float(alt_m), float(inc_deg), raan % 360.0, ma % 360.0))\n50:     return els\n51: \n52: \n53: def _state(el, world):\n54:     alt, inc, raan, ma = el\n55:     lo = world['model']['min_altitude_m']\n56:     hi = world['model']['max_altitude_m']\n57:     for _ in range(8):\n58:         st = sim.state_from_elements(alt, inc, raan, ma)\n59:         pa, aa = sim.orbit_altitudes(st)\n60:         if pa >= lo + 2000.0 and aa <= hi - 2000.0:\n61:             return st\n62:         if pa < lo + 2000.0:\n63:             alt += 8000.0\n64:         if aa > hi - 2000.0:\n65:             alt -= 8000.0\n66:         alt = _clip(alt, lo + 5000.0, hi - 5000.0)\n67:     return sim.state_from_elements(_clip(alt, lo + 5000.0, hi - 5000.0), inc, raan, ma)\n68: \n69: \n70: # ---------------------------------------------------------------- candidates\n71: class Cand:\n72:     __slots__ = ('sat', 'tgt', 'start', 'end', 'mid', 'los', 'win_start', 'win_end')\n73: \n74:     def __init__(self, sat, tgt, start, end, mid, los, win_start=0.0, win_end=0.0):\n75:         self.sat = sat; self.tgt = tgt; self.start = start\n76:         self.end = end; self.mid = mid; self.los = los\n77:         self.win_start = win_start; self.win_end = win_end\n78: \n79: \n80: def _visible_mask(world, ecef_track, margin_deg, range_margin_m):\n81:     \"\"\"Vectorised (J,T) visibility with safety margins.\"\"\"\n82:     sen = world['model']['sensor']\n83:     tg = world['targets']\n84:     tpos = np.array([t['ecef'] for t in tg], float)          # (J,3)\n85:     up = np.array([[math.cos(math.radians(t['latitude_deg'])) * math.cos(math.radians(t['longitude_deg'])),\n86:                     math.cos(math.radians(t['latitude_deg'])) * math.sin(math.radians(t['longitude_deg'])),\n87:                     math.sin(math.radians(t['latitude_deg']))] for t in tg], float)\n88:     los = ecef_track[None, :, :] - tpos[:, None, :]          # sat - target (J,T,3)\n89:     rng = np.linalg.norm(los, axis=2)\n90:     rng_safe = np.maximum(rng, 1.0)\n91:     elev = np.degrees(np.arcsin(np.clip(np.einsum('jti,ji->jt', los, up) / rng_safe, -1, 1)))\n92:     sat_norm = np.linalg.norm(ecef_track, axis=1)            # (T,)\n93:     # Off-nadir: angle between nadir (-sat_hat) and line-of-sight\n94:     # (target - sat) = -los. cos = (-sat) . (target-sat) / (|sat|*rng)\n95:     #     = sat . los / (|sat|*rng).  (Cycle-2 bug used -sat . los.)\n96:     cos_off = np.einsum('ti,jti->jt', ecef_track, los) / (sat_norm[None, :] * rng_safe)\n97:     offn = np.degrees(np.arccos(np.clip(cos_off, -1, 1)))\n98:     min_el = np.array([t['min_elevation_deg'] for t in tg], float)[:, None]\n99:     max_rng = np.minimum(np.array([t['max_slant_range_m'] for t in tg], float),\n100:                          float(sen['max_range_m']))[:, None]\n101:     return ((elev >= min_el + margin_deg) & (rng <= max_rng - range_margin_m)\n102:             & (offn <= float(sen['max_off_nadir_angle_deg']) - margin_deg))\n103: \n104: \n105: def _candidates_from_track(world, sat_idx, ecef_track, margin_deg, buffer_steps, deadline=None):\n106:     \"\"\"Multiple interior instants per visibility window (buffered start,\n107:     quartiles, buffered end), deduplicated and capped at 5 per window.\n108:     LOS (ECI unit) is recomputed at each instant's midpoint. Each Cand\n109:     records its window bounds so neighbours can be time-shifted only\n110:     within their own window.\"\"\"\n111:     vis = _visible_mask(world, ecef_track, margin_deg, 3000.0 if margin_deg > 0.5 else 500.0)\n112:     # Sanity gate: a real LEO track must see many target-time cells. If the\n113:     # hand-rolled mask yields zero / implausibly few, rebuild with the\n114:     # sim-provided helper (correct off-nadir) instead of scheduling empty.\n115:     if int(vis.sum()) < len(world['targets']):\n116:         try:\n117:             vis_sim = sim.visible(world, ecef_track, margin_deg=1e-3)\n118:             if int(vis_sim.sum()) > int(vis.sum()):\n119:                 vis = vis_sim\n120:         except Exception:\n121:             pass\n122:     ts = world['times']; H = world['horizon_s']; rot = world['rot']\n123:     out = []\n124:     # interior instant fractions derived from the window itself\n125:     fracs = (0.0, 0.25, 0.5, 0.75, 1.0)\n126:     for j, t in enumerate(world['targets']):\n127:         if deadline is not None and (j & 3) == 0 and time.time() > deadline:\n128:             break\n129:         dur = float(t['min_duration_sec'])\n130:         need = int(math.ceil(dur / sim.STEP_S))\n131:         v = vis[j].astype(np.int8)\n132:         d = np.diff(np.r_[0, v, 0])\n133:         starts = np.where(d == 1)[0]; ends = np.where(d == -1)[0]\n134:         for a, b in zip(starts, ends):\n135:             if b - a < need + 2 * buffer_steps:\n136:                 continue\n137:             lo_idx = int(a) + int(buffer_steps)\n138:             hi_idx = int(b) - int(buffer_steps) - need  # last viable start idx\n139:             if hi_idx < lo_idx:\n140:                 continue\n141:             win_s = float(ts[int(a)]); win_e = float(ts[int(b) - 1]) if int(b) > int(a) else win_s\n142:             seen = set()\n143:             for fr in fracs:\n144:                 s_idx = int(round(lo_idx + fr * (hi_idx - lo_idx)))\n145:                 if s_idx in seen:\n146:                     continue\n147:                 seen.add(s_idx)\n148:                 s0 = float(ts[s_idx]); e0 = s0 + dur\n149:                 if e0 > H:\n150:                     continue\n151:                 mid_idx = int(min(max(s_idx + need // 2, 0), len(ts) - 1))\n152:                 los_ecef = t['ecef'] - ecef_track[mid_idx]\n153:                 los_eci = rot[mid_idx].T @ los_ecef\n154:                 nrm = np.linalg.norm(los_eci)\n155:                 if nrm <= 0:\n156:                     continue\n157:                 out.append(Cand(sat_idx, j, s0, e0, s0 + dur / 2.0,\n158:                                 los_eci / nrm, win_s, win_e))\n159:     return out\n160: \n161: \n162: # ---------------------------------------------------------------- battery\n163: def _sun_hats(world):\n164:     \"\"\"Coarse sun unit vectors (ECI) every 1800 s, via brahe through sim.epoch.\"\"\"\n165:     import brahe\n166:     ts = np.arange(0.0, world['horizon_s'] + 1.0, 1800.0)\n167:     hats = []\n168:     for t in ts:\n169:         sp = np.asarray(brahe.sun_position(sim.epoch(world, float(t))), float)\n170:         hats.append(sp / max(np.linalg.norm(sp), 1.0))\n171:     return ts, np.array(hats)\n172: \n173: \n174: def _battery_ok(world, eci_tracks, actions_by_sat, sun_ts, sun_hats, margin_frac=0.02):\n175:     \"\"\"30 s-step battery simulation on (subsampled) ECI tracks; cylindrical shadow.\"\"\"\n176:     res = world['model']['resource_model']; sen = world['model']['sensor']\n177:     att = world['model']['attitude_model']\n178:     cap = float(res['battery_capacity_wh']); batt0 = float(res['initial_battery_wh'])\n179:     step_idx = np.arange(0, len(world['times']), 3)          # 30 s\n180:     t30 = world['times'][step_idx]\n181:     sun_idx = np.clip((t30 / 1800.0).astype(int), 0, len(sun_hats) - 1)\n182:     sh = sun_hats[sun_idx]\n183:     for i, acts in actions_by_sat.items():\n184:         if i >= len(eci_tracks) or len(eci_tracks) == 0:\n185:             continue\n186:         pos = eci_tracks[i][step_idx]                        # (T30,3)\n187:         proj = np.einsum('ti,ti->t', pos, sh)\n188:         perp = np.linalg.norm(pos - proj[:, None] * sh, axis=1)\n189:         sunlit = ~((proj < 0.0) & (perp < sim.R_EARTH))\n190:         rate = np.where(sunlit, float(res['sunlight_charge_rate_w']), 0.0) - float(res['idle_discharge_rate_w'])\n191:         mids = t30 + 15.0\n192:         for (s0, e0, _j, slew_before) in acts:\n193:             rate = rate - np.where((mids >= s0) & (mids < e0), float(sen['obs_discharge_rate_w']), 0.0)\n194:             if slew_before > 0:\n195:                 rate = rate - np.where((mids >= s0 - slew_before) & (mids < s0),\n196:                                        float(att['maneuver_discharge_rate_w']), 0.0)\n197:         batt = batt0\n198:         dt_h = 30.0 / 3600.0\n199:         # sequential cap-at-capacity integration\n200:         for r in rate:\n201:             batt = min(cap, batt + float(r) * dt_h)\n202:             if batt < margin_frac * cap:\n203:                 return False\n204:     return True\n205: \n206: \n207: # ---------------------------------------------------------------- scheduler\n208: def _schedule(world, cand_by_sat, sun_data, eci_by_sat, req_eff_h, deadline):\n209:     \"\"\"Global earliest-deadline scheduler on cached candidates.\n210: \n211:     Returns (actions, gaps_h, feasible, battery_ok). actions use local sat\n212:     indices 0..len(cand_by_sat)-1 (cand.sat is remapped by caller if needed).\n213:     \"\"\"\n214:     targets = world['targets']; J = len(targets); H = world['horizon_s']\n215:     att = world['model']['attitude_model']; settle = float(att['settling_time_sec'])\n216:     req_s = np.array([req_eff_h[j] * 3600.0 for j in range(J)])\n217:     # pool candidates per target: (mid, cand)\n218:     by_tgt = [[] for _ in range(J)]\n219:     for s, clist in enumerate(cand_by_sat):\n220:         for c in clist:\n221:             by_tgt[c.tgt].append(c)\n222:     mids_by = []\n223:     for j in range(J):\n224:         by_tgt[j].sort(key=lambda c: c.mid)\n225:         mids_by.append([c.mid for c in by_tgt[j]])\n226: \n227:     chosen = []                       # list of Cand (sat = position in cand_by_sat)\n228:     per_sat = [[] for _ in range(len(cand_by_sat))]   # sorted Cand lists\n229:     last = [0.0] * J\n230: \n231:     def _ang(a, b):\n232:         return math.degrees(math.acos(max(-1.0, min(1.0, float(np.dot(a.los, b.los))))))\n233: \n234:     def _sep_ok(p, c):\n235:         return c.start - p.end >= sim.slew_time(_ang(p, c), world) + settle + 2.0\n236: \n237:     def slew_ok(c):\n238:         lst = per_sat[c.sat]\n239:         starts = [x.start for x in lst]\n240:         k = bisect.bisect_left(starts, c.start)\n241:         if k > 0 and not _sep_ok(lst[k - 1], c):\n242:             return False\n243:         if k < len(lst) and not _sep_ok(c, lst[k]):\n244:             return False\n245:         return True\n246: \n247:     def slew_cost(c):\n248:         lst = per_sat[c.sat]\n249:         starts = [x.start for x in lst]\n250:         k = bisect.bisect_left(starts, c.start)\n251:         cost = 0.0\n252:         if k > 0:\n253:             cost += sim.slew_time(_ang(lst[k - 1], c), world) + settle\n254:         if k < len(lst):\n255:             cost += sim.slew_time(_ang(c, lst[k]), world) + settle\n256:         return cost\n257: \n258:     # alternative instants of the same window, for slew-safe time-shifting\n259:     alt_map = {}\n260:     for clist in cand_by_sat:\n261:         for c in clist:\n262:             alt_map.setdefault((c.sat, c.tgt, round(float(c.win_start), 1)), []).append(c)\n263:     for v in alt_map.values():\n264:         v.sort(key=lambda c: c.start)\n265: \n266:     def accept(c):\n267:         chosen.append(c)\n268:         lst = per_sat[c.sat]\n269:         starts = [x.start for x in lst]\n270:         lst.insert(bisect.bisect_left(starts, c.start), c)\n271:         if c.mid > last[c.tgt]:\n272:             last[c.tgt] = c.mid\n273: \n274:     def _pairwise_ok(lst_sorted):\n275:         return all(_sep_ok(lst_sorted[i], lst_sorted[i + 1])\n276:                    for i in range(len(lst_sorted) - 1))\n277: \n278:     def try_accept(c):\n279:         \"\"\"Insert c directly, else bounded slew-safe time-shift repair:\n280:         shift a conflicting neighbour only to another instant of its own\n281:         window; commit only after full pairwise non-overlap/slew/settling\n282:         re-check of the satellite (battery is re-checked in final audit).\"\"\"\n283:         if slew_ok(c):\n284:             accept(c); return True\n285:         lst = per_sat[c.sat]\n286:         starts = [x.start for x in lst]\n287:         k = bisect.bisect_left(starts, c.start)\n288:         neigh = []\n289:         if k > 0:\n290:             neigh.append(lst[k - 1])\n291:         if k < len(lst):\n292:             neigh.append(lst[k])\n293:         attempts = 0\n294:         for nb in neigh:\n295:             for alt in alt_map.get((nb.sat, nb.tgt, round(float(nb.win_start), 1)), []):\n296:                 if alt is nb or alt.start == nb.start:\n297:                     continue\n298:                 attempts += 1\n299:                 if attempts > 12 or time.time() > deadline:\n300:                     return False\n301:                 new_lst = sorted([x for x in lst if x is not nb] + [alt],\n302:                                  key=lambda x: x.start)\n303:                 trial = sorted(new_lst + [c], key=lambda x: x.start)\n304:                 if _pairwise_ok(trial):\n305:                     # commit shift (re-checked above), then insert c\n306:                     if nb in chosen:\n307:                         chosen.remove(nb)\n308:                     chosen.append(alt)\n309:                     per_sat[c.sat] = new_lst\n310:                     last[alt.tgt] = max([x.mid for x in chosen if x.tgt == alt.tgt] + [0.0])\n311:                     accept(c)\n312:                     return True\n313:         return False\n314: \n315:     def best_pick(idxs, lst_c, ideal_mid):\n316:         \"\"\"Among slew-feasible instants minimise slew+settling cost plus\n317:         distance to the ideal mid, i.e. maximise post-insertion slack.\"\"\"\n318:         best_c = None; best_key = None\n319:         for k in idxs:\n320:             if not (0 <= k < len(lst_c)):\n321:                 continue\n322:             c = lst_c[k]\n323:             if not slew_ok(c):\n324:                 continue\n325:             key = slew_cost(c) + 0.05 * abs(c.mid - ideal_mid)\n326:             if best_key is None or key < best_key:\n327:                 best_key = key; best_c = c\n328:         return best_c\n329: \n330:     guard = 0\n331:     while guard < 900:\n332:         guard += 1\n333:         if time.time() > deadline:\n334:             break\n335:         # targets whose final boundary is already satisfied need no more photos\n336:         pending = [j for j in range(J) if last[j] < H - req_s[j] + 60.0]\n337:         if not pending:\n338:             break\n339:         pending.sort(key=lambda j: last[j] + req_s[j])   # earliest deadline first\n340:         progressed = False\n341:         for j in pending:\n342:             dl = last[j] + req_s[j]\n343:             lst = by_tgt[j]; mids = mids_by[j]\n344:             lo = bisect.bisect_left(mids, last[j] + 0.28 * req_s[j])\n345:             hi = bisect.bisect_right(mids, dl - 300.0)\n346:             # window-flexible: choose instant by slew/slack cost near the\n347:             # latest comfortable time before the deadline\n348:             pick = best_pick(range(max(lo, hi - 40), hi), lst, dl - 300.0)\n349:             if pick is None and hi > lo:\n350:                 pick = best_pick(range(lo, min(hi, lo + 40)), lst, dl - 300.0)\n351:             if pick is None:\n352:                 k0 = bisect.bisect_left(mids, last[j] + 60.0)\n353:                 pick = best_pick(range(k0, min(len(lst), k0 + 40)), lst,\n354:                                  last[j] + 0.5 * req_s[j])\n355:             if pick is not None:\n356:                 if try_accept(pick):\n357:                     progressed = True; break\n358:             else:\n359:                 # bounded time-shift repair on a near-deadline instant\n360:                 for k in range(max(lo, hi - 10), hi):\n361:                     if 0 <= k < len(lst) and try_accept(lst[k]):\n362:                         progressed = True; break\n363:                 if progressed:\n364:                     break\n365:         if not progressed:\n366:             break\n367: \n368:     # gap repair: insert candidates into any remaining over-requirement gap\n369:     for _ in range(250):\n370:         if time.time() > deadline:\n371:             break\n372:         mids_t = [sorted(c.mid for c in chosen if c.tgt == j) for j in range(J)]\n373:         worst = None\n374:         for j in range(J):\n375:             pts = [0.0] + mids_t[j] + [H]\n376:             for a, b in zip(pts, pts[1:]):\n377:                 # largest requirement-normalised edge-inclusive gap\n378:                 if b - a > req_s[j] and (worst is None or (b - a) / req_s[j] > worst[0]):\n379:                     worst = ((b - a) / req_s[j], j, a, b)\n380:         if worst is None:\n381:             break\n382:         _, j, a, b = worst\n383:         lst = by_tgt[j]; mids = mids_by[j]\n384:         k0 = bisect.bisect_left(mids, a + 120.0); k1 = bisect.bisect_right(mids, b - 120.0)\n385:         centre = 0.5 * (a + b)\n386:         order = sorted(range(k0, k1), key=lambda k: abs(mids[k] - centre))\n387:         pick = best_pick(order[:40], lst, centre)\n388:         if pick is not None and try_accept(pick):\n389:             continue\n390:         # bounded time-shift repair before rejecting this opportunity\n391:         repaired = False\n392:         for k in order[:10]:\n393:             if try_accept(lst[k]):\n394:                 repaired = True; break\n395:         if not repaired:\n396:             break\n397: \n398:     gaps = sim.max_gaps_hours(world, {j: [c.mid for c in chosen if c.tgt == j] for j in range(J)})\n399:     req_true = np.array([t['expected_revisit_period_hours'] for t in targets], float)\n400:     feasible = bool(np.all(gaps <= req_true + 1e-9)) and len(chosen) > 0\n401:     # battery (approximate) on supplied ECI tracks, aligned with cand_by_sat order\n402:     batt_ok = True\n403:     if eci_by_sat is not None and sun_data is not None:\n404:         acts_by = {}\n405:         for s in range(len(cand_by_sat)):\n406:             lst = sorted(per_sat[s], key=lambda c: c.start)\n407:             arr = []\n408:             prev = None\n409:             for c in lst:\n410:                 sb = 0.0\n411:                 if prev is not None:\n412:                     ang = math.degrees(math.acos(max(-1.0, min(1.0, float(np.dot(prev.los, c.los))))))\n413:                     sb = sim.slew_time(ang, world) + settle\n414:                 arr.append((c.start, c.end, c.tgt, sb)); prev = c\n415:             acts_by[s] = arr\n416:         batt_ok = _battery_ok(world, eci_by_sat, acts_by, sun_data[0], sun_data[1])\n417:     # independent final slew/settling/battery audit gates acceptance\n418:     audit_ok = bool(batt_ok)\n419:     for s in range(len(cand_by_sat)):\n420:         lst = sorted(per_sat[s], key=lambda c: c.start)\n421:         if not _pairwise_ok(lst):\n422:             audit_ok = False; break\n423:     actions = [(c.sat, c.tgt, float(c.start), float(c.end)) for c in chosen]\n424:     return actions, gaps, feasible and audit_ok, audit_ok\n425: \n426: \n427: def _score(world, n, gaps, ok):\n428:     return float(sim.mission_score(world, n, gaps, bool(ok)))\n429: \n430: \n431: # ---------------------------------------------------------------- solve\n432: def solve(world, time_limit_s):\n433:     t0 = time.time()\n434:     limit = float(time_limit_s) if time_limit_s else 200.0\n435:     soft = t0 + 0.50 * limit          # hard internal deadline: 50% of limit\n436:     hard = soft\n437:     targets = world['targets']; J = len(targets)\n438:     cap = int(world['cap']); H = world['horizon_s']\n439:     req_true = [float(t['expected_revisit_period_hours']) for t in targets]\n440:     # requirement-exact internal target (<=0.02h epsilon safety margin)\n441:     req_eff = [max(1.0, r - 0.02) for r in req_true]\n442:     lats = np.array([abs(float(t['latitude_deg'])) for t in targets], float)\n443:     lo_alt = float(world['model']['min_altitude_m']); hi_alt = float(world['model']['max_altitude_m'])\n444:     alt_mid = _clip(700e3, lo_alt + 40000.0, hi_alt - 40000.0)\n445:     alt_low = _clip(550e3, lo_alt + 40000.0, hi_alt - 40000.0)\n446:     inc_lat = _clip(float(np.max(lats)) + 18.0 if J else 55.0, 50.0, 92.0)\n447: \n448:     sun_data = None\n449:     try:\n450:         sun_data = _sun_hats(world)\n451:     except Exception:\n452:         sun_data = None\n453: \n454:     cand_cache = {}    # element tuple -> (cand list with sat=0, ecef, eci subsample proxy)\n455:     track_cache = {}\n456: \n457:     def get_fast(el):\n458:         \"\"\"Cached fast track + candidates + ECI track for one element.\"\"\"\n459:         key = tuple(round(float(x), 6) for x in el)\n460:         if key in cand_cache:\n461:             return cand_cache[key]\n462:         ecef = sim.fast_positions(world, [el])[0]\n463:         # ECI from ECEF via inverse rotation, for battery simulation\n464:         eci = np.einsum('tji,tj->ti', world['rot'], ecef)\n465:         cands = _candidates_from_track(world, 0, ecef, margin_deg=1.2, buffer_steps=3,\n466:                                        deadline=hard)\n467:         cand_cache[key] = (cands, ecef, eci)\n468:         return cand_cache[key]\n469: \n470:     def evaluate_elements(els, deadline):\n471:         \"\"\"Schedule a constellation from cached fast candidates only\n472:         (no exact propagation, no re-propagation in search loops).\"\"\"\n473:         cand_by_sat = []; ecis = []\n474:         for i, el in enumerate(els):\n475:             if time.time() > deadline:\n476:                 break\n477:             cs, _ec, eci = get_fast(el)\n478:             # remap sat index to local position, preserving window bounds\n479:             cand_by_sat.append([Cand(i, c.tgt, c.start, c.end, c.mid, c.los,\n480:                                      c.win_start, c.win_end) for c in cs])\n481:             ecis.append(eci)\n482:         if len(cand_by_sat) != len(els):\n483:             return None\n484:         return _schedule(world, cand_by_sat, sun_data, ecis, req_eff, deadline)\n485: \n486:     best = None  # (score, els, actions, gaps)\n487: \n488:     def consider(els, result):\n489:         nonlocal best\n490:         if result is None:\n491:             return\n492:         actions, gaps, feasible, batt_ok = result\n493:         if not actions:\n494:             return\n495:         sc = _score(world, len(els), gaps, batt_ok)\n496:         # prefer feasible, then higher score, then fewer satellites\n497:         key = (1 if feasible else 0, sc, -len(els))\n498:         if best is None or key > best[0]:\n499:             best = (key, list(els), list(actions), np.array(gaps), bool(feasible))\n500: \n501:     # ---- Phase 1: guaranteed cap fallback (first config) + lean config screen\n502:     configs = []\n503:     for cfg in [(alt_mid, 55.0), (alt_mid, inc_lat), (alt_mid, 97.5), (alt_low, 55.0)]:\n504:         if all(abs(cfg[0] - c[0]) > 1.0 or abs(cfg[1] - c[1]) > 0.5 for c in configs):\n505:             configs.append(cfg)\n506:     configs = configs[:4]\n507: \n508:     cap_results = []\n509:     for ci, (alt, inc) in enumerate(configs):\n510:         # Lean: extra cap configs only if the floor is not yet feasible.\n511:         if ci > 0 and (time.time() > soft or (best is not None and best[4])):\n512:             break\n513:         els = _walker_elements(cap, alt, inc)\n514:         try:\n515:             res = evaluate_elements(els, min(soft, time.time() + 0.25 * limit))\n516:         except Exception:\n517:             res = None\n518:         consider(els, res)\n519:         if res is not None:\n520:             cap_results.append((alt, inc, els, res))\n521:     # fallback must exist: if screening produced nothing, build baseline directly\n522:     if best is None:\n523:         els = _walker_elements(cap, alt_mid, 55.0)\n524:         try:\n525:             res = evaluate_elements(els, hard)\n526:             consider(els, res)\n527:         except Exception:\n528:             pass\n529:     if best is None:\n530:         # Never-empty last resort: rebuild floor candidates via the sim\n531:         # helper path (margin 0, no buffer) and schedule chronologically;\n532:         # if that still yields nothing, emit the single earliest visible\n533:         # window found by sim.visible. Never return empty actions.\n534:         els = _walker_elements(cap, alt_mid, 55.0)\n535:         states = [_state(el, world) for el in els]\n536:         acts_fb = []\n537:         try:\n538:             cand_by_sat = []\n539:             for i, el in enumerate(els):\n540:                 _cs, ecef_i, _eci = get_fast(el)\n541:                 cand_by_sat.append(_candidates_from_track(world, i, ecef_i, 0.0, 0))\n542:             res_fb = _schedule(world, cand_by_sat, sun_data, None, req_true, hard)\n543:             if res_fb is not None and res_fb[0]:\n544:                 acts_fb = list(res_fb[0])\n545:         except Exception:\n546:             acts_fb = []\n547:         if not acts_fb:\n548:             try:\n549:                 for i, el in enumerate(els):\n550:                     if acts_fb:\n551:                         break\n552:                     ecef_i = sim.fast_positions(world, [el])[0]\n553:                     vis_i = sim.visible(world, ecef_i)\n554:                     for j, t in enumerate(world['targets']):\n555:                         need = int(math.ceil(float(t['min_duration_sec']) / sim.STEP_S))\n556:                         v = vis_i[j]\n557:                         idx = np.where(v)[0]\n558:                         for a in idx[::max(1, len(idx) // 50 or 1)]:\n559:                             if a + need < len(v) and bool(np.all(v[a:a + need])):\n560:                                 s0 = float(world['times'][a])\n561:                                 acts_fb = [(i, j, s0, s0 + float(t['min_duration_sec']))]\n562:                                 break\n563:                         if acts_fb:\n564:                             break\n565:             except Exception:\n566:                 pass\n567:         return {'satellites': states, 'actions': acts_fb}\n568: \n569:     # ---- Phase 2: direct reduced Walkers for the best config(s)\n570:     # rank configs by their cap result score\n571:     def cfg_rank(item):\n572:         _a, _i, _e, r = item\n573:         return _score(world, cap, r[1], r[3]) if r else -1.0\n574:     cap_results.sort(key=cfg_rank, reverse=True)\n575:     tried_small = []\n576:     if best[3] is not None and best[4]:\n577:         for (alt, inc, _els, _r) in cap_results[:1]:\n578:             if time.time() > soft:\n579:                 break\n580:             n = cap - 3\n581:             while n >= 5 and time.time() < soft:\n582:                 els = _walker_elements(n, alt, inc)\n583:                 try:\n584:                     res = evaluate_elements(els, soft)\n585:                 except Exception:\n586:                     res = None\n587:                 consider(els, res)\n588:                 tried_small.append((els, res))\n589:                 if res is not None and res[2]:\n590:                     n -= 3\n591:                 else:\n592:                     break\n593: \n594:     # ---- Phase 3: verified pruning (singles, then pairs after singles stall)\n595:     # A removal is accepted only when evaluate_elements (full cached\n596:     # requirement-exact edge-inclusive re-schedule + final slew/battery\n597:     # audit in _schedule) verifies every target; otherwise last verified\n598:     # fleet in `best` is retained.\n599:     if best[4] and time.time() < soft:\n600:         stall_pairs_done = False\n601:         while time.time() < soft and len(best[1]) > 4:\n602:             cur_els = list(best[1]); cur_actions = list(best[2])\n603:             counts = [0] * len(cur_els)\n604:             for a in cur_actions:\n605:                 if 0 <= a[0] < len(counts):\n606:                     counts[a[0]] += 1\n607:             order = sorted(range(len(cur_els)), key=lambda i: counts[i])\n608:             improved = False\n609:             for idx in order:\n610:                 if time.time() > soft:\n611:                     break\n612:                 els_try = [el for k, el in enumerate(cur_els) if k != idx]\n613:                 try:\n614:                     res = evaluate_elements(els_try, soft)\n615:                 except Exception:\n616:                     res = None\n617:                 if res is not None and res[2]:\n618:                     consider(els_try, res); improved = True; break\n619:             if improved:\n620:                 continue\n621:             if stall_pairs_done:\n622:                 break\n623:             stall_pairs_done = True\n624:             # pairs only after singles stall\n625:             pair_order = sorted(\n626:                 [(order[a], order[b]) for a in range(len(order))\n627:                  for b in range(a + 1, len(order))],\n628:                 key=lambda p: counts[p[0]] + counts[p[1]])\n629:             for (i1, i2) in pair_order:\n630:                 if time.time() > soft or len(best[1]) <= 5:\n631:                     break\n632:                 els_try = [el for k, el in enumerate(cur_els) if k not in (i1, i2)]\n633:                 try:\n634:                     res = evaluate_elements(els_try, soft)\n635:                 except Exception:\n636:                     res = None\n637:                 if res is not None and res[2]:\n638:                     consider(els_try, res); improved = True; break\n639:             if not improved:\n640:                 break\n641: \n642:     # ---- Phase 4: return best verified plan (no exact propagation)\n643:     final_els, final_actions = list(best[1]), list(best[2])\n644: \n645:     states = [_state(el, world) for el in final_els]\n646:     # remap / validate action indices and sort\n647:     acts = [(int(a[0]), int(a[1]), float(a[2]), float(a[3])) for a in final_actions\n648:             if 0 <= int(a[0]) < len(states) and 0 <= int(a[1]) < J and 0.0 <= float(a[2]) < float(a[3]) <= H]\n649:     acts.sort(key=lambda a: (a[0], a[2]))\n650:     if not acts and best[2]:\n651:         acts = [(int(a[0]), int(a[1]), float(a[2]), float(a[3])) for a in best[2]\n652:                 if 0 <= int(a[0]) < len(states) and 0 <= int(a[1]) < J]\n653:         states = [_state(el, world) for el in best[1]]\n654:         acts = [(int(a[0]), int(a[1]), float(a[2]), float(a[3])) for a in best[2]\n655:                 if 0 <= int(a[0]) < len(states) and 0 <= int(a[1]) < J and 0.0 <= float(a[2]) < float(a[3]) <= H]\n656:     return {'satellites': states, 'actions': acts}\n\n(End of file - total 656 lines)\n</content>","metadata":{"preview":"\"\"\"Window-flexible slew-aware constellation (cycle-9).\n\nOrder of work in solve():\n 1. Build and internally verify a cap-sized Walker seed; store as best-so-far\n    before any improvement (seed-first, never-empty return).\n 2. One fast-propagation pass caches, per visibility window, a small\n    deduplicated set of interior candidate instants (buffered start,\n    quartiles, buffered end); no exact propagation anywhere in solve().\n 3. Gap-critical window-flexible scheduler: fill the largest\n    requirement-normalised edge-inclusive gap, choosing the instant that\n    minimises slew+settling cost against predecessor/successor while\n    maximising post-insertion slack. Bounded slew-safe time-shift repair\n    shifts conflicting neighbours only within their own windows, with\n    non-overlap/slew/settling/battery re-checked before any insertion,\n    plus an independent final slew/settling/battery audit.\n 4. Verified pruning: singles first, then pairs only after singles stall;\n    a smaller fleet is accepted only after a full cached requirement-exact\n    (<=0.02h epsilon) edge-inclusive re-schedule plus slew/battery audit.\nHard internal deadline at 50% of time_limit_s is checked inside every\ncostly loop; on expiry the best verified non-empty plan is returned.","truncated":false,"loaded":[],"display":{"type":"file","path":"/kaggle/tmp/AI-Scientist-v3-main/results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/program_0/src/program.py","text":"\"\"\"Window-flexible slew-aware constellation (cycle-9).\n\nOrder of work in solve():\n 1. Build and internally verify a cap-sized Walker seed; store as best-so-far\n    before any improvement (seed-first, never-empty return).\n 2. One fast-propagation pass caches, per visibility window, a small\n    deduplicated set of interior candidate instants (buffered start,\n    quartiles, buffered end); no exact propagation anywhere in solve().\n 3. Gap-critical window-flexible scheduler: fill the largest\n    requirement-normalised edge-inclusive gap, choosing the instant that\n    minimises slew+settling cost against predecessor/successor while\n    maximising post-insertion slack. Bounded slew-safe time-shift repair\n    shifts conflicting neighbours only within their own windows, with\n    non-overlap/slew/settling/battery re-checked before any insertion,\n    plus an independent final slew/settling/battery audit.\n 4. Verified pruning: singles first, then pairs only after singles stall;\n    a smaller fleet is accepted only after a full cached requirement-exact\n    (<=0.02h epsilon) edge-inclusive re-schedule plus slew/battery audit.\nHard internal deadline at 50% of time_limit_s is checked inside every\ncostly loop; on expiry the best verified non-empty plan is returned.\nAll parameters derive from world cap/requirements/duration.\n\"\"\"\nimport math\nimport time\nimport bisect\n\nimport numpy as np\nimport sim\n\n\n# ---------------------------------------------------------------- helpers\ndef _clip(v, lo, hi):\n    return float(min(max(v, lo), hi))\n\n\ndef _walker_elements(n, alt_m, inc_deg):\n    \"\"\"Uneven-plane Walker-like elements: list of (alt, inc, raan, mean_anom).\"\"\"\n    n = int(max(1, n))\n    planes = max(1, int(round(math.sqrt(n))))\n    base, rem = divmod(n, planes)\n    els = []\n    for p in range(planes):\n        cnt = base + (1 if p < rem else 0)\n        if cnt == 0:\n            continue\n        raan = 360.0 * p / planes\n        for s in range(cnt):\n            ma = 360.0 * s / cnt + 360.0 * p / max(n, 1)\n            els.append((float(alt_m), float(inc_deg), raan % 360.0, ma % 360.0))\n    return els\n\n\ndef _state(el, world):\n    alt, inc, raan, ma = el\n    lo = world['model']['min_altitude_m']\n    hi = world['model']['max_altitude_m']\n    for _ in range(8):\n        st = sim.state_from_elements(alt, inc, raan, ma)\n        pa, aa = sim.orbit_altitudes(st)\n        if pa >= lo + 2000.0 and aa <= hi - 2000.0:\n            return st\n        if pa < lo + 2000.0:\n            alt += 8000.0\n        if aa > hi - 2000.0:\n            alt -= 8000.0\n        alt = _clip(alt, lo + 5000.0, hi - 5000.0)\n    return sim.state_from_elements(_clip(alt, lo + 5000.0, hi - 5000.0), inc, raan, ma)\n\n\n# ---------------------------------------------------------------- candidates\nclass Cand:\n    __slots__ = ('sat', 'tgt', 'start', 'end', 'mid', 'los', 'win_start', 'win_end')\n\n    def __init__(self, sat, tgt, start, end, mid, los, win_start=0.0, win_end=0.0):\n        self.sat = sat; self.tgt = tgt; self.start = start\n        self.end = end; self.mid = mid; self.los = los\n        self.win_start = win_start; self.win_end = win_end\n\n\ndef _visible_mask(world, ecef_track, margin_deg, range_margin_m):\n    \"\"\"Vectorised (J,T) visibility with safety margins.\"\"\"\n    sen = world['model']['sensor']\n    tg = world['targets']\n    tpos = np.array([t['ecef'] for t in tg], float)          # (J,3)\n    up = np.array([[math.cos(math.radians(t['latitude_deg'])) * math.cos(math.radians(t['longitude_deg'])),\n                    math.cos(math.radians(t['latitude_deg'])) * math.sin(math.radians(t['longitude_deg'])),\n                    math.sin(math.radians(t['latitude_deg']))] for t in tg], float)\n    los = ecef_track[None, :, :] - tpos[:, None, :]          # sat - target (J,T,3)\n    rng = np.linalg.norm(los, axis=2)\n    rng_safe = np.maximum(rng, 1.0)\n    elev = np.degrees(np.arcsin(np.clip(np.einsum('jti,ji->jt', los, up) / rng_safe, -1, 1)))\n    sat_norm = np.linalg.norm(ecef_track, axis=1)            # (T,)\n    # Off-nadir: angle between nadir (-sat_hat) and line-of-sight\n    # (target - sat) = -los. cos = (-sat) . (target-sat) / (|sat|*rng)\n    #     = sat . los / (|sat|*rng).  (Cycle-2 bug used -sat . los.)\n    cos_off = np.einsum('ti,jti->jt', ecef_track, los) / (sat_norm[None, :] * rng_safe)\n    offn = np.degrees(np.arccos(np.clip(cos_off, -1, 1)))\n    min_el = np.array([t['min_elevation_deg'] for t in tg], float)[:, None]\n    max_rng = np.minimum(np.array([t['max_slant_range_m'] for t in tg], float),\n                         float(sen['max_range_m']))[:, None]\n    return ((elev >= min_el + margin_deg) & (rng <= max_rng - range_margin_m)\n            & (offn <= float(sen['max_off_nadir_angle_deg']) - margin_deg))\n\n\ndef _candidates_from_track(world, sat_idx, ecef_track, margin_deg, buffer_steps, deadline=None):\n    \"\"\"Multiple interior instants per visibility window (buffered start,\n    quartiles, buffered end), deduplicated and capped at 5 per window.\n    LOS (ECI unit) is recomputed at each instant's midpoint. Each Cand\n    records its window bounds so neighbours can be time-shifted only\n    within their own window.\"\"\"\n    vis = _visible_mask(world, ecef_track, margin_deg, 3000.0 if margin_deg > 0.5 else 500.0)\n    # Sanity gate: a real LEO track must see many target-time cells. If the\n    # hand-rolled mask yields zero / implausibly few, rebuild with the\n    # sim-provided helper (correct off-nadir) instead of scheduling empty.\n    if int(vis.sum()) < len(world['targets']):\n        try:\n            vis_sim = sim.visible(world, ecef_track, margin_deg=1e-3)\n            if int(vis_sim.sum()) > int(vis.sum()):\n                vis = vis_sim\n        except Exception:\n            pass\n    ts = world['times']; H = world['horizon_s']; rot = world['rot']\n    out = []\n    # interior instant fractions derived from the window itself\n    fracs = (0.0, 0.25, 0.5, 0.75, 1.0)\n    for j, t in enumerate(world['targets']):\n        if deadline is not None and (j & 3) == 0 and time.time() > deadline:\n            break\n        dur = float(t['min_duration_sec'])\n        need = int(math.ceil(dur / sim.STEP_S))\n        v = vis[j].astype(np.int8)\n        d = np.diff(np.r_[0, v, 0])\n        starts = np.where(d == 1)[0]; ends = np.where(d == -1)[0]\n        for a, b in zip(starts, ends):\n            if b - a < need + 2 * buffer_steps:\n                continue\n            lo_idx = int(a) + int(buffer_steps)\n            hi_idx = int(b) - int(buffer_steps) - need  # last viable start idx\n            if hi_idx < lo_idx:\n                continue\n            win_s = float(ts[int(a)]); win_e = float(ts[int(b) - 1]) if int(b) > int(a) else win_s\n            seen = set()\n            for fr in fracs:\n                s_idx = int(round(lo_idx + fr * (hi_idx - lo_idx)))\n                if s_idx in seen:\n                    continue\n                seen.add(s_idx)\n                s0 = float(ts[s_idx]); e0 = s0 + dur\n                if e0 > H:\n                    continue\n                mid_idx = int(min(max(s_idx + need // 2, 0), len(ts) - 1))\n                los_ecef = t['ecef'] - ecef_track[mid_idx]\n                los_eci = rot[mid_idx].T @ los_ecef\n                nrm = np.linalg.norm(los_eci)\n                if nrm <= 0:\n                    continue\n                out.append(Cand(sat_idx, j, s0, e0, s0 + dur / 2.0,\n                                los_eci / nrm, win_s, win_e))\n    return out\n\n\n# ---------------------------------------------------------------- battery\ndef _sun_hats(world):\n    \"\"\"Coarse sun unit vectors (ECI) every 1800 s, via brahe through sim.epoch.\"\"\"\n    import brahe\n    ts = np.arange(0.0, world['horizon_s'] + 1.0, 1800.0)\n    hats = []\n    for t in ts:\n        sp = np.asarray(brahe.sun_position(sim.epoch(world, float(t))), float)\n        hats.append(sp / max(np.linalg.norm(sp), 1.0))\n    return ts, np.array(hats)\n\n\ndef _battery_ok(world, eci_tracks, actions_by_sat, sun_ts, sun_hats, margin_frac=0.02):\n    \"\"\"30 s-step battery simulation on (subsampled) ECI tracks; cylindrical shadow.\"\"\"\n    res = world['model']['resource_model']; sen = world['model']['sensor']\n    att = world['model']['attitude_model']\n    cap = float(res['battery_capacity_wh']); batt0 = float(res['initial_battery_wh'])\n    step_idx = np.arange(0, len(world['times']), 3)          # 30 s\n    t30 = world['times'][step_idx]\n    sun_idx = np.clip((t30 / 1800.0).astype(int), 0, len(sun_hats) - 1)\n    sh = sun_hats[sun_idx]\n    for i, acts in actions_by_sat.items():\n        if i >= len(eci_tracks) or len(eci_tracks) == 0:\n            continue\n        pos = eci_tracks[i][step_idx]                        # (T30,3)\n        proj = np.einsum('ti,ti->t', pos, sh)\n        perp = np.linalg.norm(pos - proj[:, None] * sh, axis=1)\n        sunlit = ~((proj < 0.0) & (perp < sim.R_EARTH))\n        rate = np.where(sunlit, float(res['sunlight_charge_rate_w']), 0.0) - float(res['idle_discharge_rate_w'])\n        mids = t30 + 15.0\n        for (s0, e0, _j, slew_before) in acts:\n            rate = rate - np.where((mids >= s0) & (mids < e0), float(sen['obs_discharge_rate_w']), 0.0)\n            if slew_before > 0:\n                rate = rate - np.where((mids >= s0 - slew_before) & (mids < s0),\n                                       float(att['maneuver_discharge_rate_w']), 0.0)\n        batt = batt0\n        dt_h = 30.0 / 3600.0\n        # sequential cap-at-capacity integration\n        for r in rate:\n            batt = min(cap, batt + float(r) * dt_h)\n            if batt < margin_frac * cap:\n                return False\n    return True\n\n\n# ---------------------------------------------------------------- scheduler\ndef _schedule(world, cand_by_sat, sun_data, eci_by_sat, req_eff_h, deadline):\n    \"\"\"Global earliest-deadline scheduler on cached candidates.\n\n    Returns (actions, gaps_h, feasible, battery_ok). actions use local sat\n    indices 0..len(cand_by_sat)-1 (cand.sat is remapped by caller if needed).\n    \"\"\"\n    targets = world['targets']; J = len(targets); H = world['horizon_s']\n    att = world['model']['attitude_model']; settle = float(att['settling_time_sec'])\n    req_s = np.array([req_eff_h[j] * 3600.0 for j in range(J)])\n    # pool candidates per target: (mid, cand)\n    by_tgt = [[] for _ in range(J)]\n    for s, clist in enumerate(cand_by_sat):\n        for c in clist:\n            by_tgt[c.tgt].append(c)\n    mids_by = []\n    for j in range(J):\n        by_tgt[j].sort(key=lambda c: c.mid)\n        mids_by.append([c.mid for c in by_tgt[j]])\n\n    chosen = []                       # list of Cand (sat = position in cand_by_sat)\n    per_sat = [[] for _ in range(len(cand_by_sat))]   # sorted Cand lists\n    last = [0.0] * J\n\n    def _ang(a, b):\n        return math.degrees(math.acos(max(-1.0, min(1.0, float(np.dot(a.los, b.los))))))\n\n    def _sep_ok(p, c):\n        return c.start - p.end >= sim.slew_time(_ang(p, c), world) + settle + 2.0\n\n    def slew_ok(c):\n        lst = per_sat[c.sat]\n        starts = [x.start for x in lst]\n        k = bisect.bisect_left(starts, c.start)\n        if k > 0 and not _sep_ok(lst[k - 1], c):\n            return False\n        if k < len(lst) and not _sep_ok(c, lst[k]):\n            return False\n        return True\n\n    def slew_cost(c):\n        lst = per_sat[c.sat]\n        starts = [x.start for x in lst]\n        k = bisect.bisect_left(starts, c.start)\n        cost = 0.0\n        if k > 0:\n            cost += sim.slew_time(_ang(lst[k - 1], c), world) + settle\n        if k < len(lst):\n            cost += sim.slew_time(_ang(c, lst[k]), world) + settle\n        return cost\n\n    # alternative instants of the same window, for slew-safe time-shifting\n    alt_map = {}\n    for clist in cand_by_sat:\n        for c in clist:\n            alt_map.setdefault((c.sat, c.tgt, round(float(c.win_start), 1)), []).append(c)\n    for v in alt_map.values():\n        v.sort(key=lambda c: c.start)\n\n    def accept(c):\n        chosen.append(c)\n        lst = per_sat[c.sat]\n        starts = [x.start for x in lst]\n        lst.insert(bisect.bisect_left(starts, c.start), c)\n        if c.mid > last[c.tgt]:\n            last[c.tgt] = c.mid\n\n    def _pairwise_ok(lst_sorted):\n        return all(_sep_ok(lst_sorted[i], lst_sorted[i + 1])\n                   for i in range(len(lst_sorted) - 1))\n\n    def try_accept(c):\n        \"\"\"Insert c directly, else bounded slew-safe time-shift repair:\n        shift a conflicting neighbour only to another instant of its own\n        window; commit only after full pairwise non-overlap/slew/settling\n        re-check of the satellite (battery is re-checked in final audit).\"\"\"\n        if slew_ok(c):\n            accept(c); return True\n        lst = per_sat[c.sat]\n        starts = [x.start for x in lst]\n        k = bisect.bisect_left(starts, c.start)\n        neigh = []\n        if k > 0:\n            neigh.append(lst[k - 1])\n        if k < len(lst):\n            neigh.append(lst[k])\n        attempts = 0\n        for nb in neigh:\n            for alt in alt_map.get((nb.sat, nb.tgt, round(float(nb.win_start), 1)), []):\n                if alt is nb or alt.start == nb.start:\n                    continue\n                attempts += 1\n                if attempts > 12 or time.time() > deadline:\n                    return False\n                new_lst = sorted([x for x in lst if x is not nb] + [alt],\n                                 key=lambda x: x.start)\n                trial = sorted(new_lst + [c], key=lambda x: x.start)\n                if _pairwise_ok(trial):\n                    # commit shift (re-checked above), then insert c\n                    if nb in chosen:\n                        chosen.remove(nb)\n                    chosen.append(alt)\n                    per_sat[c.sat] = new_lst\n                    last[alt.tgt] = max([x.mid for x in chosen if x.tgt == alt.tgt] + [0.0])\n                    accept(c)\n                    return True\n        return False\n\n    def best_pick(idxs, lst_c, ideal_mid):\n        \"\"\"Among slew-feasible instants minimise slew+settling cost plus\n        distance to the ideal mid, i.e. maximise post-insertion slack.\"\"\"\n        best_c = None; best_key = None\n        for k in idxs:\n            if not (0 <= k < len(lst_c)):\n                continue\n            c = lst_c[k]\n            if not slew_ok(c):\n                continue\n            key = slew_cost(c) + 0.05 * abs(c.mid - ideal_mid)\n            if best_key is None or key < best_key:\n                best_key = key; best_c = c\n        return best_c\n\n    guard = 0\n    while guard < 900:\n        guard += 1\n        if time.time() > deadline:\n            break\n        # targets whose final boundary is already satisfied need no more photos\n        pending = [j for j in range(J) if last[j] < H - req_s[j] + 60.0]\n        if not pending:\n            break\n        pending.sort(key=lambda j: last[j] + req_s[j])   # earliest deadline first\n        progressed = False\n        for j in pending:\n            dl = last[j] + req_s[j]\n            lst = by_tgt[j]; mids = mids_by[j]\n            lo = bisect.bisect_left(mids, last[j] + 0.28 * req_s[j])\n            hi = bisect.bisect_right(mids, dl - 300.0)\n            # window-flexible: choose instant by slew/slack cost near the\n            # latest comfortable time before the deadline\n            pick = best_pick(range(max(lo, hi - 40), hi), lst, dl - 300.0)\n            if pick is None and hi > lo:\n                pick = best_pick(range(lo, min(hi, lo + 40)), lst, dl - 300.0)\n            if pick is None:\n                k0 = bisect.bisect_left(mids, last[j] + 60.0)\n                pick = best_pick(range(k0, min(len(lst), k0 + 40)), lst,\n                                 last[j] + 0.5 * req_s[j])\n            if pick is not None:\n                if try_accept(pick):\n                    progressed = True; break\n            else:\n                # bounded time-shift repair on a near-deadline instant\n                for k in range(max(lo, hi - 10), hi):\n                    if 0 <= k < len(lst) and try_accept(lst[k]):\n                        progressed = True; break\n                if progressed:\n                    break\n        if not progressed:\n            break\n\n    # gap repair: insert candidates into any remaining over-requirement gap\n    for _ in range(250):\n        if time.time() > deadline:\n            break\n        mids_t = [sorted(c.mid for c in chosen if c.tgt == j) for j in range(J)]\n        worst = None\n        for j in range(J):\n            pts = [0.0] + mids_t[j] + [H]\n            for a, b in zip(pts, pts[1:]):\n                # largest requirement-normalised edge-inclusive gap\n                if b - a > req_s[j] and (worst is None or (b - a) / req_s[j] > worst[0]):\n                    worst = ((b - a) / req_s[j], j, a, b)\n        if worst is None:\n            break\n        _, j, a, b = worst\n        lst = by_tgt[j]; mids = mids_by[j]\n        k0 = bisect.bisect_left(mids, a + 120.0); k1 = bisect.bisect_right(mids, b - 120.0)\n        centre = 0.5 * (a + b)\n        order = sorted(range(k0, k1), key=lambda k: abs(mids[k] - centre))\n        pick = best_pick(order[:40], lst, centre)\n        if pick is not None and try_accept(pick):\n            continue\n        # bounded time-shift repair before rejecting this opportunity\n        repaired = False\n        for k in order[:10]:\n            if try_accept(lst[k]):\n                repaired = True; break\n        if not repaired:\n            break\n\n    gaps = sim.max_gaps_hours(world, {j: [c.mid for c in chosen if c.tgt == j] for j in range(J)})\n    req_true = np.array([t['expected_revisit_period_hours'] for t in targets], float)\n    feasible = bool(np.all(gaps <= req_true + 1e-9)) and len(chosen) > 0\n    # battery (approximate) on supplied ECI tracks, aligned with cand_by_sat order\n    batt_ok = True\n    if eci_by_sat is not None and sun_data is not None:\n        acts_by = {}\n        for s in range(len(cand_by_sat)):\n            lst = sorted(per_sat[s], key=lambda c: c.start)\n            arr = []\n            prev = None\n            for c in lst:\n                sb = 0.0\n                if prev is not None:\n                    ang = math.degrees(math.acos(max(-1.0, min(1.0, float(np.dot(prev.los, c.los))))))\n                    sb = sim.slew_time(ang, world) + settle\n                arr.append((c.start, c.end, c.tgt, sb)); prev = c\n            acts_by[s] = arr\n        batt_ok = _battery_ok(world, eci_by_sat, acts_by, sun_data[0], sun_data[1])\n    # independent final slew/settling/battery audit gates acceptance\n    audit_ok = bool(batt_ok)\n    for s in range(len(cand_by_sat)):\n        lst = sorted(per_sat[s], key=lambda c: c.start)\n        if not _pairwise_ok(lst):\n            audit_ok = False; break\n    actions = [(c.sat, c.tgt, float(c.start), float(c.end)) for c in chosen]\n    return actions, gaps, feasible and audit_ok, audit_ok\n\n\ndef _score(world, n, gaps, ok):\n    return float(sim.mission_score(world, n, gaps, bool(ok)))\n\n\n# ---------------------------------------------------------------- solve\ndef solve(world, time_limit_s):\n    t0 = time.time()\n    limit = float(time_limit_s) if time_limit_s else 200.0\n    soft = t0 + 0.50 * limit          # hard internal deadline: 50% of limit\n    hard = soft\n    targets = world['targets']; J = len(targets)\n    cap = int(world['cap']); H = world['horizon_s']\n    req_true = [float(t['expected_revisit_period_hours']) for t in targets]\n    # requirement-exact internal target (<=0.02h epsilon safety margin)\n    req_eff = [max(1.0, r - 0.02) for r in req_true]\n    lats = np.array([abs(float(t['latitude_deg'])) for t in targets], float)\n    lo_alt = float(world['model']['min_altitude_m']); hi_alt = float(world['model']['max_altitude_m'])\n    alt_mid = _clip(700e3, lo_alt + 40000.0, hi_alt - 40000.0)\n    alt_low = _clip(550e3, lo_alt + 40000.0, hi_alt - 40000.0)\n    inc_lat = _clip(float(np.max(lats)) + 18.0 if J else 55.0, 50.0, 92.0)\n\n    sun_data = None\n    try:\n        sun_data = _sun_hats(world)\n    except Exception:\n        sun_data = None\n\n    cand_cache = {}    # element tuple -> (cand list with sat=0, ecef, eci subsample proxy)\n    track_cache = {}\n\n    def get_fast(el):\n        \"\"\"Cached fast track + candidates + ECI track for one element.\"\"\"\n        key = tuple(round(float(x), 6) for x in el)\n        if key in cand_cache:\n            return cand_cache[key]\n        ecef = sim.fast_positions(world, [el])[0]\n        # ECI from ECEF via inverse rotation, for battery simulation\n        eci = np.einsum('tji,tj->ti', world['rot'], ecef)\n        cands = _candidates_from_track(world, 0, ecef, margin_deg=1.2, buffer_steps=3,\n                                       deadline=hard)\n        cand_cache[key] = (cands, ecef, eci)\n        return cand_cache[key]\n\n    def evaluate_elements(els, deadline):\n        \"\"\"Schedule a constellation from cached fast candidates only\n        (no exact propagation, no re-propagation in search loops).\"\"\"\n        cand_by_sat = []; ecis = []\n        for i, el in enumerate(els):\n            if time.time() > deadline:\n                break\n            cs, _ec, eci = get_fast(el)\n            # remap sat index to local position, preserving window bounds\n            cand_by_sat.append([Cand(i, c.tgt, c.start, c.end, c.mid, c.los,\n                                     c.win_start, c.win_end) for c in cs])\n            ecis.append(eci)\n        if len(cand_by_sat) != len(els):\n            return None\n        return _schedule(world, cand_by_sat, sun_data, ecis, req_eff, deadline)\n\n    best = None  # (score, els, actions, gaps)\n\n    def consider(els, result):\n        nonlocal best\n        if result is None:\n            return\n        actions, gaps, feasible, batt_ok = result\n        if not actions:\n            return\n        sc = _score(world, len(els), gaps, batt_ok)\n        # prefer feasible, then higher score, then fewer satellites\n        key = (1 if feasible else 0, sc, -len(els))\n        if best is None or key > best[0]:\n            best = (key, list(els), list(actions), np.array(gaps), bool(feasible))\n\n    # ---- Phase 1: guaranteed cap fallback (first config) + lean config screen\n    configs = []\n    for cfg in [(alt_mid, 55.0), (alt_mid, inc_lat), (alt_mid, 97.5), (alt_low, 55.0)]:\n        if all(abs(cfg[0] - c[0]) > 1.0 or abs(cfg[1] - c[1]) > 0.5 for c in configs):\n            configs.append(cfg)\n    configs = configs[:4]\n\n    cap_results = []\n    for ci, (alt, inc) in enumerate(configs):\n        # Lean: extra cap configs only if the floor is not yet feasible.\n        if ci > 0 and (time.time() > soft or (best is not None and best[4])):\n            break\n        els = _walker_elements(cap, alt, inc)\n        try:\n            res = evaluate_elements(els, min(soft, time.time() + 0.25 * limit))\n        except Exception:\n            res = None\n        consider(els, res)\n        if res is not None:\n            cap_results.append((alt, inc, els, res))\n    # fallback must exist: if screening produced nothing, build baseline directly\n    if best is None:\n        els = _walker_elements(cap, alt_mid, 55.0)\n        try:\n            res = evaluate_elements(els, hard)\n            consider(els, res)\n        except Exception:\n            pass\n    if best is None:\n        # Never-empty last resort: rebuild floor candidates via the sim\n        # helper path (margin 0, no buffer) and schedule chronologically;\n        # if that still yields nothing, emit the single earliest visible\n        # window found by sim.visible. Never return empty actions.\n        els = _walker_elements(cap, alt_mid, 55.0)\n        states = [_state(el, world) for el in els]\n        acts_fb = []\n        try:\n            cand_by_sat = []\n            for i, el in enumerate(els):\n                _cs, ecef_i, _eci = get_fast(el)\n                cand_by_sat.append(_candidates_from_track(world, i, ecef_i, 0.0, 0))\n            res_fb = _schedule(world, cand_by_sat, sun_data, None, req_true, hard)\n            if res_fb is not None and res_fb[0]:\n                acts_fb = list(res_fb[0])\n        except Exception:\n            acts_fb = []\n        if not acts_fb:\n            try:\n                for i, el in enumerate(els):\n                    if acts_fb:\n                        break\n                    ecef_i = sim.fast_positions(world, [el])[0]\n                    vis_i = sim.visible(world, ecef_i)\n                    for j, t in enumerate(world['targets']):\n                        need = int(math.ceil(float(t['min_duration_sec']) / sim.STEP_S))\n                        v = vis_i[j]\n                        idx = np.where(v)[0]\n                        for a in idx[::max(1, len(idx) // 50 or 1)]:\n                            if a + need < len(v) and bool(np.all(v[a:a + need])):\n                                s0 = float(world['times'][a])\n                                acts_fb = [(i, j, s0, s0 + float(t['min_duration_sec']))]\n                                break\n                        if acts_fb:\n                            break\n            except Exception:\n                pass\n        return {'satellites': states, 'actions': acts_fb}\n\n    # ---- Phase 2: direct reduced Walkers for the best config(s)\n    # rank configs by their cap result score\n    def cfg_rank(item):\n        _a, _i, _e, r = item\n        return _score(world, cap, r[1], r[3]) if r else -1.0\n    cap_results.sort(key=cfg_rank, reverse=True)\n    tried_small = []\n    if best[3] is not None and best[4]:\n        for (alt, inc, _els, _r) in cap_results[:1]:\n            if time.time() > soft:\n                break\n            n = cap - 3\n            while n >= 5 and time.time() < soft:\n                els = _walker_elements(n, alt, inc)\n                try:\n                    res = evaluate_elements(els, soft)\n                except Exception:\n                    res = None\n                consider(els, res)\n                tried_small.append((els, res))\n                if res is not None and res[2]:\n                    n -= 3\n                else:\n                    break\n\n    # ---- Phase 3: verified pruning (singles, then pairs after singles stall)\n    # A removal is accepted only when evaluate_elements (full cached\n    # requirement-exact edge-inclusive re-schedule + final slew/battery\n    # audit in _schedule) verifies every target; otherwise last verified\n    # fleet in `best` is retained.\n    if best[4] and time.time() < soft:\n        stall_pairs_done = False\n        while time.time() < soft and len(best[1]) > 4:\n            cur_els = list(best[1]); cur_actions = list(best[2])\n            counts = [0] * len(cur_els)\n            for a in cur_actions:\n                if 0 <= a[0] < len(counts):\n                    counts[a[0]] += 1\n            order = sorted(range(len(cur_els)), key=lambda i: counts[i])\n            improved = False\n            for idx in order:\n                if time.time() > soft:\n                    break\n                els_try = [el for k, el in enumerate(cur_els) if k != idx]\n                try:\n                    res = evaluate_elements(els_try, soft)\n                except Exception:\n                    res = None\n                if res is not None and res[2]:\n                    consider(els_try, res); improved = True; break\n            if improved:\n                continue\n            if stall_pairs_done:\n                break\n            stall_pairs_done = True\n            # pairs only after singles stall\n            pair_order = sorted(\n                [(order[a], order[b]) for a in range(len(order))\n                 for b in range(a + 1, len(order))],\n                key=lambda p: counts[p[0]] + counts[p[1]])\n            for (i1, i2) in pair_order:\n                if time.time() > soft or len(best[1]) <= 5:\n                    break\n                els_try = [el for k, el in enumerate(cur_els) if k not in (i1, i2)]\n                try:\n                    res = evaluate_elements(els_try, soft)\n                except Exception:\n                    res = None\n                if res is not None and res[2]:\n                    consider(els_try, res); improved = True; break\n            if not improved:\n                break\n\n    # ---- Phase 4: return best verified plan (no exact propagation)\n    final_els, final_actions = list(best[1]), list(best[2])\n\n    states = [_state(el, world) for el in final_els]\n    # remap / validate action indices and sort\n    acts = [(int(a[0]), int(a[1]), float(a[2]), float(a[3])) for a in final_actions\n            if 0 <= int(a[0]) < len(states) and 0 <= int(a[1]) < J and 0.0 <= float(a[2]) < float(a[3]) <= H]\n    acts.sort(key=lambda a: (a[0], a[2]))\n    if not acts and best[2]:\n        acts = [(int(a[0]), int(a[1]), float(a[2]), float(a[3])) for a in best[2]\n                if 0 <= int(a[0]) < len(states) and 0 <= int(a[1]) < J]\n        states = [_state(el, world) for el in best[1]]\n        acts = [(int(a[0]), int(a[1]), float(a[2]), float(a[3])) for a in best[2]\n                if 0 <= int(a[0]) < len(states) and 0 <= int(a[1]) < J and 0.0 <= float(a[2]) < float(a[3]) <= H]\n    return {'satellites': states, 'actions': acts}","lineStart":1,"lineEnd":656,"totalLines":656,"truncated":false}},"title":"results/revisit/opencode/20261030_163231/investigation/worker_02/ideas/10_geometry_diverse_constructive_growth_for_six_hour_revisit_compression/program_0/src/program.py","time":{"start":1793383420387,"end":1793383420880}},"metadata":{"openai":{"itemId":"fc_01a18dfb4fad769ba899d6b2e135e5de"}},"id":"prt_18dfb51b3001F3gxnwt0nQnN01","sessionID":"ses_e72053da9ffeY5Vp446Zu901pu","messageID":"msg_18dfb4bd0001eo383KVGOu27rq"}}
